section data:
    grid:
    db 0*120

    hello_world:
    db "Hello World", 0



section text:
_start:
    mov a0, grid
    mov a1, hello_world
    mov a2, 11

    call _print


_print:
    ; Print to a0 string at a1 with a2 length

    mov a3, 0
    _print_loop:
        add a4, a1, a3  ; String base + i
        load a5, [a4]   ; Load string

        add a4, a0, a3  ; Store base + i
        store [a4], a5  ; Store string

        add a3, a3, 1   ; Add one to i
        cmp a3, a2  ; Check if offset = length of string

    jnz _print_loop

    ret

