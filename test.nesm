; Test mov reg to reg
add r1, r0, 42
mov r2, r1              ; r2 should be 42
sub r3, r2, r1          ; should be 0
jnz _fail

; Test mov doesnt affect src
add r1, r0, 99
mov r2, r1              ; r2 = 99
add r3, r0, 99
sub r4, r2, r3          ; should be 0
jnz _fail

; Test movi
mov r1, 77
add r2, r0, 77
sub r3, r1, r2          ; should be 0
jnz _fail

; Test movi with 0
mov r1, 0
jnz _fail               ; r1 should be 0, but flags wont be set by movi...
sub r2, r1, r0          ; use sub instead to check
jnz _fail

; Test movi overwrites previous value
add r1, r0, 55
mov r1, 33
add r2, r0, 33
sub r3, r1, r2          ; should be 0
jnz _fail

; Test mov label address
mov r1, _data_start
add r2, r0, 77
stor [r1], r2           ; store at label address
load r3, [r1]           ; load back
sub r4, r3, r2          ; should be 0
jnz _fail

; All passed
add r15, r0, 10
jmp _end

_fail:
add r15, r0, 99
jmp _end

_data_start:
_end:
jmp _end