section text:

_start:
    mov sp, 0xFFFF
    mov bp, sp

    call _test_basic_call
    cmp ra, 42
    jne _fail

    mov ra, 0

    call _test_nested
    cmp ra, 100
    jne _fail

    mov ra, 0

    call _test_locals
    cmp ra, 30
    jne _fail

    mov ra, 0

    call _test_stack_preserved
    cmp ra, 7
    jne _fail

    ; all passed
    mov r12, 10
    jmp _end

_fail:
    mov r12, 99
    io r0, r0, r0, 0

_end:
    jmp _end


; Test 1: basic call returns correct value
_test_basic_call:
    sub sp, sp, 4
    store [sp], bp
    mov bp, sp

    mov ra, 42

    mov sp, bp
    load bp, [sp]
    add sp, sp, 4
    ret


; Test 2: nested calls, each adds 25
_test_nested:
    sub sp, sp, 4
    store [sp], bp
    mov bp, sp

    call _add_25
    call _add_25
    call _add_25
    call _add_25
    ; ra should be 100

    mov sp, bp
    load bp, [sp]
    add sp, sp, 4
    ret

_add_25:
    sub sp, sp, 4
    store [sp], bp
    mov bp, sp

    add ra, ra, 25

    mov sp, bp
    load bp, [sp]
    add sp, sp, 4
    ret


; Test 3: local variables survive across calls
_test_locals:
    sub sp, sp, 4
    store [sp], bp
    mov bp, sp
    sub sp, sp, 8

    mov r3, 10
    store [bp - 4], r3      ; local a = 10

    mov r3, 20
    store [bp - 8], r3      ; local b = 20

    call _add_25            ; trashes ra and scratch regs

    load r3, [bp - 4]       ; reload a
    load r4, [bp - 8]       ; reload b
    add ra, r3, r4          ; ra = 10 + 20 = 30

    mov sp, bp
    load bp, [sp]
    add sp, sp, 4
    ret


; Test 4: scratch registers not preserved across calls
; but bp and sp should be intact
_test_stack_preserved:
    sub sp, sp, 4
    store [sp], bp
    mov bp, sp
    sub sp, sp, 4

    mov r3, 7
    store [bp - 4], r3      ; save 7 to local

    call _trash_registers   ; trashes r3-r12

    load ra, [bp - 4]       ; should still be 7

    mov sp, bp
    load bp, [sp]
    add sp, sp, 4
    ret

_trash_registers:
    sub sp, sp, 4
    store [sp], bp
    mov bp, sp

    mov r3, 0xDEAD
    mov r4, 0xDEAD
    mov r5, 0xDEAD
    mov r6, 0xDEAD
    mov r7, 0xDEAD
    mov r8, 0xDEAD
    mov r9, 0xDEAD
    mov r10, 0xDEAD
    mov r11, 0xDEAD
    mov r12, 0xDEAD

    mov sp, bp
    load bp, [sp]
    add sp, sp, 4
    ret