struct State {
    cursor_pos: u32,
}


fn main() {
    __asm (
        "mov t1, 0x00",
        "mov t2, 0x00",
        "io zero, t1, t2, screen",
    );

    let state = State {
        cursor_pos: 0
    };

    loop {
        let c = read_key();
        if (c == 0 as char) { continue; };

        handle_keypress(&state, c);
    }

    return 0;
}


fn handle_keypress(state: *State, c: char) {
    let addr = 0x08000000 + (*state).cursor_pos;

    *(addr as *char) = c;
    (*state).cursor_pos += 1;

    return;
}



fn read_key() -> char {
    let c: char = '\0';
    __asm (
        "io t1, zero, zero, keyboard",
        out(c, 1),
    );
    return c;
}