struct State {
    cursor_pos: u32,
}


fn main() {
    __asm (
        "mov t1, 0x00",
        "mov t2, 0x00",
        "io zero, t1, t2, screen",

        "mov t1, 0x01",
        "mov t2, 0xFFE6EDF3",
        "io zero, t1, t2, screen",

        "mov t1, 0x02",
        "mov t2, 0xFF4E2229",
        "io zero, t1, t2, screen",
    );

    let state = State {
        cursor_pos: 0
    };

    for let i = 0; i <= 255; i += 1 {
        *((0x08000000 + i) as *u8) = i;
    }
    

    loop {
        let c = read_key();
        if (c == 0 as char) { continue; };

        handle_keypress(&state, c);
    }

    return 0;
}


fn handle_keypress(state: *State, c: char) {
    let addr = 0x08000000 + state->cursor_pos;

    if c == 8 as char {
        // Backspace
        state->cursor_pos -= 1;
        *((addr - 1) as *char) = '\0';
    } else if c == 38 as char {
        // Up
        state->cursor_pos -= 96;
    } else if c == 37 as char {
        // Left
        state->cursor_pos -= 1;
    } else if c == 39 as char {
        // Right 
        state->cursor_pos += 1;
    } else if c == 40 as char {
        // Down
        state->cursor_pos += 96;
    } else {
        *(addr as *char) = c;
        state->cursor_pos += 1;
    }

    return;
}



fn read_key() -> char {
    let c: char = '\0';
    __asm (
        "io t1, zero, zero, keyboard",
        out(c, 1),
    );
    return c;
}


fn print_num(addr: u32, num: u32) {
    let i = 0;
    let go = true;

    while i < 5 {
        let part = num % 10;
        let c: char = part as char + '0';
        
        if (go) {
            *((addr - i) as *char) = c;
        } else {
            *((addr - i) as *u8) = 0;
        }
        

        num = num / 10;
        i += 1;
        if num == 0 {
            go = false;
        }
    }
    
    return;
}