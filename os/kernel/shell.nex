#include <stdlib.nex>

struct State {
    cursor_pos: u32,
}


fn main() {
    __asm (
        "mov t1, 0x00",
        "mov t2, 0x01",
        "io zero, t1, t2, screen",
    );

    let state = State {
        cursor_pos: 0
    };

    for let i = 0; i < 100; i += 1 {
        let i_4 = i*4;
        *((0x08000000 + i_4) as *u32) = 0x00FFFFFF;
    };

    loop {
        let c = read_key();
        if (c == 0 as char) { continue; };

        handle_keypress(&state, c);
    }

    return 0;
}


fn handle_keypress(state: *State, c: char) {
    let pos_4 = state->cursor_pos;
    let addr = 0x08000000 + pos_4;

    if c == 8 as char {
        // Backspace
        state->cursor_pos -= 1;
        *((addr - 1) as *char) = '\0';
    } else if c == 38 as char {
        // Up
        state->cursor_pos -= 96;
    } else if c == 37 as char {
        // Left
        state->cursor_pos -= 1;
    } else if c == 39 as char {
        // Right 
        state->cursor_pos += 1;
    } else if c == 40 as char {
        // Down
        state->cursor_pos += 96;
    } else {
        *(addr as *u32) = 0x000F000F;
        *((addr+3) as *char) = c;
        state->cursor_pos += 1;
    }

    return;
}
