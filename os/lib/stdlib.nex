// Add stdlib function requests in github.

fn read_key() -> char {
    let c: char = '\0';
    __asm (
        "io t1, zero, zero, keyboard",
        out(c, 1),
    );
    return c;
}


fn print_num(addr: u32, num: u32) {
    let i = 0;
    let go = true;

    while (go) {
        let part = num % 10;
        let c: char = part as char + '0';
        
        if (go) {
            *((addr - i) as *char) = c;
        } else {
            *((addr - i) as *u8) = 0;
        }
        

        num = num / 10;
        i += 1;
        if num == 0 {
            go = false;
        }
    }
    
    return;
}


fn get_clock_time() -> u32 {
    let t: u32;
    __asm (
        "io t1, zero, zero, time",
        out(t, 1)
    );
    return t;
}

fn set_screen_data_offset(offset: u32) {
    __asm (
        in(offset, 1),
        "mov t2, 0x01",
        "io zero, t2, t1, screen"
    );
    return;
}


fn sleep(time: u32){
    let start_time = get_clock_time();
    let now_time = get_clock_time();
    while ((now_time - start_time) < time) {
        now_time = get_clock_time();
    }
    return;
}
 