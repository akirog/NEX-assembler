#define FILETABLE_ADDRESS 0x10000
#define FILETABLE_FIRST_ENTRY_ADDRESS 0x10004

#define FILETABLE_ENTRY_NAME_SIZE 24
#define FILETABLE_ENTRY_SIZE 32


int cursor_pos = 0x4000;
int command_pos = 0;
int command_len = 0;


int main() {
    asm (
        "mov r1, 0x1"
        "mov r2, 0x4000"
        "io, zero, r1, r2, screen"
    );

    print_prompt();

    while (true) {
        
        asm (
            "mov r1, 1"
            "io, r1, r1, zero, keyboard"
            "mov r2, 4100"
            "store [r2], r1"
        );

        int* p = (int*)4100;

        if (*p & 0x10000) {
            asm (
                "io, r1, zero, zero, keyboard"
                "mov r2, 4100"
                "store [r2], r1"
            );
            
            if (*p & 0x100) {
                char c = (char)(*p & 0xFF);

                handle_keypress(c);
            }
        }
    }

    return 0;
}



void handle_keypress(char key) {
    if (key == (char)13) {
        cursor_pos -= 1;
        command_len -= 1;
        *(char*)cursor_pos = (char)0;
        return;
    } else if (key == (char)10) {
        handle_enter();
        return;
    }

    print_string(&key, cursor_pos, 1);
    cursor_pos += 1;
    command_len += 1;
    return;
}


void handle_enter() {
    // Make newline
    cursor_pos = cursor_pos + (96-((cursor_pos-0x4000)%96));


    // Handle command
    if (string_matches((char*)command_pos, "ls", 2) && command_len == 2) {
        print_string("listing files...", cursor_pos, 16);
        cursor_pos = cursor_pos + (96-((cursor_pos-0x4000)%96));
        list_command();

    } else if (string_matches((char*)command_pos, "run ", 4) && command_len > 4) {
        print_string("running file...", cursor_pos, 15);
        cursor_pos = cursor_pos + (96-((cursor_pos-0x4000)%96));
        run_file((char*)(command_pos + 4));

    }

    
    // Make newline
    cursor_pos = cursor_pos + (96-((cursor_pos-0x4000)%96));
    print_prompt();
    return;
}


void print_prompt() {
    print_string("> ", cursor_pos, 2);
    cursor_pos += 2;
    command_pos = cursor_pos;
    command_len = 0;
}


void print_string(char* string, char* location, int str_len) {
    int idx = 0;
    while (idx < str_len) {
        location[idx] = string[idx];

        idx += 1;
    }

    return;
}



bool string_matches(char *str_1, char *str_2, int length) {
    int idx = 0;
    while (idx < length) {
        if (str_1[idx] != str_2[idx]) {
            return false;
        }

        idx += 1;
    }
    return true;
}



void list_command() {
    char file_name[FILETABLE_ENTRY_NAME_SIZE];

    for (int i = 0; i < 5; i += 1) {
        int entry_address =
            FILETABLE_FIRST_ENTRY_ADDRESS + (i * FILETABLE_ENTRY_SIZE);

        // Load the filename from the file table.
        load_storage(
            (int*)entry_address,
            file_name,
            FILETABLE_ENTRY_NAME_SIZE
        );

        // Find the actual filename length.
        int name_len = 0;

        while (name_len < FILETABLE_ENTRY_NAME_SIZE &&
               file_name[name_len] != (char)0) {
            name_len += 1;
        }

        // Print filename.
        print_string(file_name, cursor_pos, name_len);

        // Move to the next line.
        cursor_pos = cursor_pos +
            (96 - ((cursor_pos - 0x4000) % 96));
    }

    return;
}


void run_file(char* file_name) {
    asm (
        "mov a1, a0" // filename pointer
        "mov a0, 59" // exec syscall
        "mov at, 0x80"
        "trigint at"
    );
}


void load_storage(int* load_addr, int* store_addr, int load_count) {
    asm (
        "add a2, a2, a0"
        "__load_loop:"
        "io a3, a0, a0, rom"
        "storeb [a1], a3"
        "addi a0, a0, 1"
        "addi a1, a1, 1"
        "bl a0, a2 __load_loop"
    );
}