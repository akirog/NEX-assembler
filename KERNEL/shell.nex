#define GET_KEYCODES_SYSCALL 12


int cursor_pos = 0x4000;
int command_pos = 0;
int command_len = 0;


int main() {
    asm (
        "mov k0, 0x1"
        "mov k1, 0x4000"
        "io, zero, k0, k1, screen"
    );

    print_prompt();

    while (true) {
        
        asm (
            "mov k0, 1"
            "io, k0, k0, zero, keyboard"
            "mov k1, 4100"
            "store [k1], k0"
        );

        int* p = (int*)4100;

        if (*p & 0x10000) {
            asm (
                "io, k0, zero, zero, keyboard"
                "mov k1, 4100"
                "store [k1], k0"
            );
            
            if (*p & 0x100) {
                char c = (char)(*p & 0xFF);

                handle_keypress(c);
            }
        }
    }

    return 0;
}



void handle_keypress(char key) {
    if (key == (char)13) {
        cursor_pos -= 1;
        *(int*)cursor_pos = 0;
        return;
    }

    print_string(&key, cursor_pos, 1);
    cursor_pos += 1;
    return;
}


void print_prompt() {
    print_string("> ", cursor_pos, 2);
    cursor_pos += 2;
    command_pos = cursor_pos;
    command_len = 0;
}


void print_string(char* string, char* location, int str_len) {
    int idx = 0;
    while (idx < str_len) {
        location[idx] = string[idx];

        idx += 1;
    }

    return;
}