#define GET_KEYCODES_SYSCALL 12


int cursor_pos = 0x4000;
int command_pos = 0;
int command_len = 0;


int main() {
    asm (
        "mov r0, 0x1"
        "mov r1, 0x4000"
        "io, r0, r0, r1, 3"
    );

    print_prompt();

    while (true) {
        
        asm (
            "io, r0, r0, r0, 2"
            "mov r1, 5000"
            "store [r1], r0"
        );

        int* p = (int*)5000;

        if (*p & (0x100)) {
            char c = *p;

            handle_keypress(c);
        }

    }

    return 0;
}



void handle_keypress(char key) {
    print_string(&key, cursor_pos, 1);
    cursor_pos += 1;
}


void print_prompt() {
    print_string("> ", cursor_pos, 2);
    cursor_pos += 2;
    command_pos = cursor_pos;
    command_len = 0;
}


void print_string(char* string, char* location, int str_len) {
    int idx = 0;
    while (idx < str_len) {
        location[idx] = string[idx];

        idx += 1;
    }

    return;
}