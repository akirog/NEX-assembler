// Kernel / os of the system
#baseaddr 0x20000

// 0x1000 is amount of files
#define FILETABLE_ADDRESS 0x1000
#define FILETABLE_FIRST_ENTRY_ADDRESS 0x1004

#define FILETABLE_ENTRY_NAME_SIZE 24
#define FILETABLE_ENTRY_SIZE 32


int main() {
    // Set interrupt handler to int_handler
    asm (
        "mov r1, __int_entry" // This really isn't a good way of getting the address of that function but idc
        "setvec zero, r1, zero ; Set interrupt handler"
    );

    // Start the shell, that hands off the execution and the kernel doesnt come back to main after that.
    start_shell();

    return 0;
}


asm (
   "__int_entry:"
   "; store regs"
   "; mov a0 int code"
   "; call int_handler"
   "; load regs"
   "; iret"
);


int int_handler(int int_code) {
    if (int_code == 0x80) {
        // Syscalls
        handle_syscall();
    } else if (int_code == 0x10) {
        // Key pressed
        handle_key_int();
    }


    return;
}



void handle_syscall(int syscall_num) {
    asm (
        "store [bp - 4], r0"
    );

    return;
}




void handle_key_int(char pressed_char) {
    asm (
        "io r0, r0, r0, 2"
        "store byte [bp - 1], r0"
    );

    return;
}



void start_shell() {
    // Check if command matches any of the loaded programs
    // For now we'll just load the first programs name
    // Name is the first part of the entry, so we will load from filetable address
    char curr_entry_name[FILETABLE_ENTRY_NAME_SIZE];
    char *shell_name = "shell";

    for (int i = 0; i < 5; i += 1) {
        int entry_address = FILETABLE_FIRST_ENTRY_ADDRESS + (i*FILETABLE_ENTRY_SIZE);
        load_storage(entry_address, curr_entry_name, FILETABLE_ENTRY_NAME_SIZE);

        if (string_matches(curr_entry_name, shell_name, 5)) {
            print_string("Found shell", 96*6, 11);
            int data_length;
            load_storage(entry_address + FILETABLE_ENTRY_NAME_SIZE, &data_length, sizeof(data_length));

            int data_address;
            load_storage(entry_address + FILETABLE_ENTRY_NAME_SIZE + 4, &data_address, sizeof(data_address));

            load_storage(data_address, 0x00, data_length);
            
            asm (
                "mov ra, 0x00"
                "jr ra"
            );
        }
    }
}



void print_string(char* string, char* location, int str_len) {
    int idx = 0;
    while (idx < str_len) {
        location[idx] = string[idx];

        idx += 1;

    }

    return;
}


bool string_matches(char *str_1, char *str_2, int length) {
    int idx = 0;
    while (idx < length) {
        if (str_1[idx] != str_2[idx]) {
            return false;
        }

        idx += 1;
    }
    return true;
}


void load_storage(int* load_addr, int* store_addr, int load_count) {
    asm (
        "add a2, a2, a0"
        "__load_loop:"
        "io a3, a0, a0, 5"
        "store byte [a1], a3"
        "add a0, a0, 1"
        "add a1, a1, 1"
        "cmp a0, a2"
        "jl __load_loop"
    );
}