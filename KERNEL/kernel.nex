// Kernel / os of the system
#baseaddr 0x1000
#define SCREEN_WIDTH 96

// 0x1000 is amount of files
#define FILETABLE_ADDRESS 0x1000
#define FILETABLE_FIRST_ENTRY_ADDRESS 0x1004

#define FILETABLE_ENTRY_NAME_SIZE 24
#define FILETABLE_ENTRY_SIZE 32


int cursor_pos = 0;
char *command_buffer = 0;


int main() {
    // Set interrupt handler to int_handler
    asm (
        "mov r0, int_handler" // This really isn't a good way of getting the address of that function but idc
        "io r0, r0, r0, 1 ; Set interrupt handler"
    );

    // Print prompt
    print_prompt();

    // Wait forever to check if keyboard interrupt works
    while (true) {
        
    }    

    return 0;
}



interrupt int_handler(int int_code) {
    // Clear keyboard press thing and set arguments
    asm (
        "getint r0"
        "store [a0], r0"
    );


    if (int_code == 16) {
        handle_key_int();
    }


    return;
}


void handle_key_int(char pressed_char) {
    asm (
        "io r0, r0, r0, 2"
        "shr r1, r0, 8"
        "and r1, r1, 1"
        "cmp r1, 0"
        "jz __skip_keypress_handler"
        "store byte [bp - 1], r0"
    );

    if (pressed_char == (char)13) {
        // Backspace pressed
        cursor_pos = cursor_pos - 1;
        pressed_char = (char)0;
        print_string(&pressed_char, cursor_pos, 1);

    } else if (pressed_char == (char)4) {
        // Left arrow
        cursor_pos = cursor_pos - 1;
    } else if (pressed_char == (char)1) {
        // Up arrow
        cursor_pos = cursor_pos - SCREEN_WIDTH;
    } else if (pressed_char == (char)2) {
        // Right arrow
        cursor_pos = cursor_pos + 1;
    } else if (pressed_char == (char)3) {
        // Down arrow
        cursor_pos = cursor_pos + SCREEN_WIDTH;
    } else if (pressed_char == (char)10) {
        // Enter
        handle_submit();
    } else {
        print_string(&pressed_char, cursor_pos, 1);
        cursor_pos = cursor_pos + 1;
    }

    asm (
        "__skip_keypress_handler:"
    );
    return;
}



void handle_submit() {
    int command_length = cursor_pos - command_buffer;
    cursor_pos = cursor_pos + (SCREEN_WIDTH-(cursor_pos%SCREEN_WIDTH));


    char len_as_str = (char)(command_length + 48);


    // Check if command matches any of the loaded programs
    // For now we'll just load the first programs name
    // Name is the first part of the entry, so we will load from filetable address
    char curr_entry_name[FILETABLE_ENTRY_NAME_SIZE];

    for (int i = 0; i < 5; i += 1) {
        load_storage(FILETABLE_FIRST_ENTRY_ADDRESS + (i*FILETABLE_ENTRY_SIZE), curr_entry_name, FILETABLE_ENTRY_NAME_SIZE);

        if (string_matches(curr_entry_name, command_buffer, command_length)) {
            print_string(curr_entry_name, cursor_pos, FILETABLE_ENTRY_NAME_SIZE);

            cursor_pos = cursor_pos + (SCREEN_WIDTH-(cursor_pos%SCREEN_WIDTH));
        }
    }


    print_prompt();
    command_buffer = cursor_pos;
    return;
}



void print_prompt() {
    print_string("> ", cursor_pos, 2);
    cursor_pos = cursor_pos + 2;
    command_buffer = cursor_pos;
}


void print_string(char* string, char* location, int str_len) {
    int idx = 0;
    while (idx < str_len) {
        location[idx] = string[idx];

        idx += 1;

    }

    return;
}


bool string_matches(char *str_1, char *str_2, int length) {
    int idx = 0;
    while (idx < length) {
        if (str_1[idx] != str_2[idx]) {
            return false;
        }
    }
    return true;
}


void load_storage(int* load_addr, int* store_addr, int load_count) {
    asm (
        "add a2, a2, a0"
        "__load_loop:"
        "io a3, a0, a0, 5"
        "store byte [a1], a3"
        "add a0, a0, 1"
        "add a1, a1, 1"
        "cmp a0, a2"
        "jl __load_loop"
    );
}