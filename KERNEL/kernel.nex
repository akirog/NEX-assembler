// Kernel / os of the system
#baseaddr 0x1000
#define SCREEN_WIDTH 96


char *test_string = "You pressed something!";
int cursor_pos = 0;
char *command_buffer = 0;


int main() {
    // Set interrupt handler to int_handler
    asm (
        "mov r0, int_handler" // This really isn't a good way of getting the address of that function but idc
        "io r0, r0, r0, 1 ; Set interrupt handler"
    );

    // Print prompt
    print_prompt();

    // Wait forever to check if keyboard interrupt works
    while (true) {
        
    }    

    return 0;
}



interrupt int_handler(int int_code, char pressed_char) {
    // Clear keyboard press thing and set arguments
    asm (
        "io a1, r0, r0, 2"
        "shr r3, a1, 8"
        "and r3, r3, 1"
        "cmp r3, 0"
        "jz __handler_end"
        "and a1, a1, 0xFF"
        "store byte [bp - 69], a1"
    );

    if (pressed_char == (char)13) {
        // Backspace pressed
        cursor_pos = cursor_pos - 1;
        pressed_char = (char)0;
        print_string(&pressed_char, cursor_pos, 1);

    } else if (pressed_char == (char)4) {
        // Left arrow
        cursor_pos = cursor_pos - 1;
    } else if (pressed_char == (char)1) {
        // Up arrow
        cursor_pos = cursor_pos - SCREEN_WIDTH;
    } else if (pressed_char == (char)2) {
        // Right arrow
        cursor_pos = cursor_pos + 1;
    } else if (pressed_char == (char)3) {
        // Down arrow
        cursor_pos = cursor_pos + SCREEN_WIDTH;
    } else if (pressed_char == (char)10) {
        // Enter
        handle_submit();
    } else {
        print_string(&pressed_char, cursor_pos, 1);
        cursor_pos = cursor_pos + 1;
    }
    

    asm (
        "__handler_end:"
    );

    return;
}




void handle_submit() {
    cursor_pos = cursor_pos + (SCREEN_WIDTH-(cursor_pos%SCREEN_WIDTH));


    cursor_pos = cursor_pos + (SCREEN_WIDTH-(cursor_pos%SCREEN_WIDTH));
    print_prompt();
    command_buffer = cursor_pos;
    return;
}



void print_prompt() {
    char *prompt = "> ";
    print_string(prompt, cursor_pos, 2);
    cursor_pos = cursor_pos + 2;
    command_buffer = cursor_pos;
}


void print_string(char* string, char* location, int str_len) {
    int idx = 0;
    while (idx < str_len) {
        location[idx] = string[idx];

        idx += 1;

    }

    return;
}

