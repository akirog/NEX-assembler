// Kernel / os of the system
#baseaddr 0x20000

// 0x1000 is amount of files
#define FILETABLE_ADDRESS 0x10000
#define FILETABLE_FIRST_ENTRY_ADDRESS 0x10004

#define FILETABLE_ENTRY_NAME_SIZE 24
#define FILETABLE_ENTRY_SIZE 32


int main() {
    // Set interrupt handler to int_handler
    asm (
        "mov r1, __int_entry"
        "setvec r1 ; Set interrupt handler"
    );

    // Start the shell, that hands off the execution and the kernel doesnt come back to main after that.
    start_shell();

    return 0;
}


