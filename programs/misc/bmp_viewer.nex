/*
BMP STRUCTURE
Header: 14 bytes
        Signature:  2b
0x02    FileSize:   4b  File size in bytes
        reserved:   4b
0x0A    DataOffset: 4b  Offset of where image is stored


Info header: 40 bytes
        Size:   4b  size of header
0x12    Width:  4b  Width of image 
0x16    Height: 4b  Height of image
        Planes: 2b
        BPP:    2b  Bits per pixel
the rest prob arent important        


Looks like each pixel is stored as

i+0: blue
i+1: green
i+2: red
i+3: opacity?
*/

// 0x1000 is amount of files
#define FILETABLE_ADDRESS 0x10000
#define FILETABLE_FIRST_ENTRY_ADDRESS 0x10004

#define FILETABLE_ENTRY_NAME_SIZE 24
#define FILETABLE_ENTRY_SIZE 32





int main() {
    asm (
        "mov r1, 0"
        "mov r2, 3"
        "io zero, r1, r2, screen"

        "mov r1, 2"
        "mov r2, 3"
        "io zero, r1, r2, screen"
    );

    load_file(0x4000);

    int i = 0x0;
    while (true) {
        int g = *(int*)(i + 0x4000);
        int b = g << 16;
        int r = (g >> 16) & 0xFF;
        
        g = g & 0xFF00;
        g |= r;
        g |= b;
        
        *(int*)(i + 0x4000) = g;

        i += 4;
    }
}




void load_storage(int* load_addr, int* store_addr, int load_count) {
    asm (
        "add a2, a2, a0"
        "__load_loop:"
        "io a3, a0, a0, rom"
        "storeb [a1], a3"
        "addi a0, a0, 1"
        "addi a1, a1, 1"
        "bl a0, a2 __load_loop"
    );
}



void load_file(int *load_location) {
    char curr_entry_name[FILETABLE_ENTRY_NAME_SIZE];
    char filename[24] = "bmp_image";

    for (int i = 0; i < 5; i += 1) {
        int entry_address = FILETABLE_FIRST_ENTRY_ADDRESS + (i*FILETABLE_ENTRY_SIZE);
        load_storage(entry_address, curr_entry_name, FILETABLE_ENTRY_NAME_SIZE);

        if (string_matches(curr_entry_name, filename, 24)) {
            int data_length;
            load_storage(entry_address + FILETABLE_ENTRY_NAME_SIZE, &data_length, sizeof(data_length));

            int data_address;
            load_storage(entry_address + FILETABLE_ENTRY_NAME_SIZE + 4, &data_address, sizeof(data_address));

            load_storage(data_address+0x8A, load_location, data_length);
        }
    }
}



bool string_matches(char *str_1, char *str_2, int length) {
    int idx = 0;
    while (idx < length) {
        if (str_1[idx] != str_2[idx]) {
            return false;
        }

        idx += 1;
    }
    return true;
}