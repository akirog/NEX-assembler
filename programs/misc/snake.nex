#define SCREEN_WIDTH 96



int snake_x = 30;
int snake_y = 30;

// Snake dir:
// 0: right
// 1: up
// 2: left
// 3: down
int snake_dir = 0;


int main() {

    int i = 0;
    int needed = 2;

    while (true) {
        update_pos();



        draw();
        i += 1;
        if (i > needed) {
            snake_dir += 1;
            i = 0;
            needed += 1;
            if (needed > 15) {
                char (*shell_name)[24] = "shell";
                run_file(shell_name);
            }
        }
    }
}


void update_pos() {
    if (snake_dir > 3) {
        snake_dir = 0;
    }

    if (snake_dir == 0) {
        snake_x += 1;
    } else if (snake_dir == 1) {
        snake_y -= 1;
    } else if (snake_dir == 2) {
        snake_x -= 1;
    } else {
        snake_y += 1;
    }
}


void draw() {
    char* pos = 0x4000 + snake_x + snake_y*SCREEN_WIDTH;

    *pos = '#';
}




void run_file(char* file_name) {
    asm (
        "mov a1, a0" // filename pointer
        "mov a0, 59" // exec syscall
        "mov v0, 0x80"
        "trigint v0"
    );
}