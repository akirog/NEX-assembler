// ---------- Shitty snake copy -----------

#define SCREEN_WIDTH 96
#define SCREEN_HEIGHT 46

#define MAX_SNAKE_LENGTH 20

char shell_name[24] = "shell";


int snake_x[MAX_SNAKE_LENGTH] = {30};
int snake_y[MAX_SNAKE_LENGTH] = {30};

int snake_len = 1;

// Snake dir:
// 0: right
// 1: up
// 2: left
// 3: down
int snake_dir = 0;


int main() {
    
    draw();

    while (true) {
        char key = get_key();

        if (key == (char)0) {
            continue;
        } else if (key == 'd') {
            snake_dir = 0;
        } else if (key == 'w') {
            snake_dir = 1;
        } else if (key == 'a') {
            snake_dir = 2;
        } else if (key == 's') {
            snake_dir = 3;
            grow_snake();
        } else if (key == (char)27) {
            run_file(&shell_name);
        }
        


        update_pos();
        draw();
    }
}


void grow_snake() {
    snake_len += 1;

    if (snake_len >= MAX_SNAKE_LENGTH) {
        snake_len = MAX_SNAKE_LENGTH;
    }
}


void update_pos() {
    if (snake_dir > 3) {
        snake_dir = 0;
    }

    shift_snake();

    if (snake_dir == 0) {
        snake_x[0] = snake_x[0] + 1;
    } else if (snake_dir == 1) {
        snake_y[0] = snake_y[0] - 1;
    } else if (snake_dir == 2) {
        snake_x[0] = snake_x[0] - 1;
    } else {
        snake_y[0] = snake_y[0] + 1;
    }
}


void shift_snake() {
    for (int i = snake_len - 1; i > 0; i -= 1) {
        snake_x[i] = snake_x[i-1];
        snake_y[i] = snake_y[i-1];
    }
}


void draw() {
    for (int i = 0x4000; i < 0x4000 + SCREEN_WIDTH*SCREEN_HEIGHT; i += 4) {
        *(int*)i = 0;
    }

    for (int i = 0; i < snake_len; i += 1) {
        char* pos = 0x4000 + snake_x[i] + snake_y[i]*SCREEN_WIDTH;

        *pos = '#';
    }
}




void run_file(char* file_name) {
    asm (
        "mov a1, a0" // filename pointer
        "mov a0, 59" // exec syscall
        "mov v0, 0x80"
        "trigint v0"
    );
}



char get_key() {
    asm (
        "mov r1, 1"
        "io, r1, r1, zero, keyboard"
        "mov r2, 4100"
        "store [r2], r1"
    );

    int* p = (int*)4100;

    if (*p & 0x10000) {
        asm (
            "io, r1, zero, zero, keyboard"
            "mov r2, 4100"
            "store [r2], r1"
        );
        
        if (*p & 0x100) {
            char c = (char)(*p & 0xFF);

            return c;
        }
    }

    return (char)0;
}