// Tiny Zelda-like room for the NEX machine.
// Controls: W/A/S/D move, Q quits.
// Screen memory: 96x46 bytes at 0x4000 (same mapping used by snake.nex).
#include "programs/libraries/stdlib.nex"

int player_x = 12;
int player_y = 12;
int old_x = 12;
int old_y = 12;

int main() {
    draw_room();

    while (true) {
        char key = get_key();

        if (key == 'q' || key == (char)96) {
            return 0;
        }

        old_x = player_x;
        old_y = player_y;

        if (key == 'w') player_y -= 1;
        else if (key == 's') player_y += 1;
        else if (key == 'a') player_x -= 1;
        else if (key == 'd') player_x += 1;

        // Keep the player inside the room.
        if (player_x < 2) player_x = 2;
        if (player_x > 93) player_x = 93;
        if (player_y < 2) player_y = 2;
        if (player_y > 43) player_y = 43;

        if (player_x != old_x || player_y != old_y) {
            draw_room();
        }
    }
    return 0;
}

void draw_room() {
    // Clear the 96x46 character framebuffer.
    for (int i = 0x4000; i < 0x4000 + SCREEN_WIDTH * SCREEN_HEIGHT; i += 1) {
        *(char*)i = ' ';
    }

    // Grass-like dotted floor.
    for (int y = 1; y < 45; y += 1) {
        for (int x = 1; x < 95; x += 1) {
            if ((x + y) % 7 == 0) {
                *(char*)(0x4000 + x + y * SCREEN_WIDTH) = '.';
            }
        }
    }

    // Room border.
    for (int x = 0; x < SCREEN_WIDTH; x += 1) {
        *(char*)(0x4000 + x) = '-';
        *(char*)(0x4000 + x + 45 * SCREEN_WIDTH) = '-';
    }
    for (int y = 0; y < SCREEN_HEIGHT; y += 1) {
        *(char*)(0x4000 + y * SCREEN_WIDTH) = '|';
        *(char*)(0x4000 + 95 + y * SCREEN_WIDTH) = '|';
    }

    // A simple obstacle / rock formation.
    for (int y = 17; y < 24; y += 1) {
        for (int x = 38; x < 53; x += 1) {
            *(char*)(0x4000 + x + y * SCREEN_WIDTH) = '#';
        }
    }

    // Small doorway at the bottom.
    for (int x = 45; x < 51; x += 1) {
        *(char*)(0x4000 + x + 45 * SCREEN_WIDTH) = ' ';
    }
    *(char*)(0x4000 + 48 + 44 * SCREEN_WIDTH) = 'v';

    // Player: @ is the hero.
    *(char*)(0x4000 + player_x + player_y * SCREEN_WIDTH) = '@';

    // HUD.
    char* title = "THE LITTLE KINGDOM";
    for (int i = 0; title[i] != 0; i += 1) {
        *(char*)(0x4000 + 3 + i) = title[i];
    }
    char* help = "WASD: MOVE   Q: QUIT";
    for (int i = 0; help[i] != 0; i += 1) {
        *(char*)(0x4000 + 3 + i + 46 * SCREEN_WIDTH) = help[i];
    }
}
