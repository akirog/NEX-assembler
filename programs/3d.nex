
#define SCREEN_WIDTH 32*4
#define FIXED_SCALE 1000


fn main() {
    __asm (
        "mov t1, 0x00",
        "mov t2, 0x03",
        "io zero, t1, t2, screen"
    );

    let vertices: [Vec3; 3] = [
        Vec3 { x: 0, y: 100, z: 300 },    // top
        Vec3 { x: -100, y: -100, z: 300 }, // bottom left
        Vec3 { x: 100, y: -100, z: 300 },  // bottom right
    ];

    let faces: [[u32; 3]; 1] = [
        [0, 1, 2]
    ];

    draw_face(faces[0], &vertices);

    loop {}
}


fn draw_face(face: [u32; 3], vertices: [Vec3]) {
    let v0 = &vertices[face[0]];
    let v1 = &vertices[face[1]];
    let v2 = &vertices[face[2]];

    project_line(v0, v1);
    project_line(v1, v2);
    project_line(v2, v0);

    return;
}


fn project_line(pos1: *Vec3, pos2: *Vec3) {
    let pos1 = Vec2 {
        x: pos1->x*FIXED_SCALE/pos1->z,
        y: pos1->y*FIXED_SCALE/pos1->z,
    };

    let pos2 = Vec2 {
        x: pos2->x*FIXED_SCALE/pos2->z,
        y: pos2->y*FIXED_SCALE/pos2->z
    };

    // -100 to 100
    // 0    to 200
    // 0    to 100xWIDTH
    // 0    to WIDTH
    pos1.x = (pos1.x + FIXED_SCALE) * 32*4 / (2*FIXED_SCALE);
    pos1.y = (pos1.y + FIXED_SCALE) * 32*3 / (2*FIXED_SCALE);

    pos2.x = (pos2.x + FIXED_SCALE) * 32*4 / (2*FIXED_SCALE);
    pos2.y = (pos2.y + FIXED_SCALE) * 32*3 / (2*FIXED_SCALE);

    draw_line(pos1, pos2);

    return;
}


fn draw_line(pos1: Vec2, pos2: Vec2) {
    *screen_pos_to_addr(&pos1) = 0xFFFFFFFF;
    *screen_pos_to_addr(&pos2) = 0xFFFFFFFF;


    let abs_dx = pos2.x - pos1.x;
    let abs_dy = pos2.y - pos1.y;
    if abs_dx < 0 {
        abs_dx = -abs_dx;
    }
    if abs_dy < 0 {
        abs_dy = -abs_dy;
    }

    let steep = abs_dy > abs_dx;
    if steep {
        let temp = pos1.y;
        pos1.y = pos1.x;
        pos1.x = temp;

        temp = pos2.y;
        pos2.y = pos2.x;
        pos2.x = temp;
    }


    if pos1.x > pos2.x {
        let temp = pos2;
        pos2 = pos1;
        pos1 = temp;
    };


    let dy = pos2.y - pos1.y;
    let dx = pos2.x - pos1.x;

    let sign = (((dy >= 0) * 2) - 1);
    
    dy *= sign;

    let err = dx/2;

    let y = pos1.y;


    for let x = pos1.x; x < pos2.x; x += 1 {
        err += dy;
        if err > dx {
            y += sign;
            
            err -= dx;
        }
        
        let pos;
        if steep {
            pos = Vec2 {
                x: y,
                y: x,
            };
        } else {
            pos = Vec2 {
                x: x,
                y: y,
            };
        };
        
        

        *screen_pos_to_addr(&pos) = 0xFFFFFFFF;
    };

    return;
}


fn screen_pos_to_addr(pos: *Vec2) -> *u32 {
    let addr = 0x08000000;
    addr += pos->x * 4;
    addr += pos->y * SCREEN_WIDTH * 4;

    return addr as *u32;
}


struct Vec3 {
    x: i32,
    y: i32,
    z: i32,
}

struct Vec2 {
    x: i32,
    y: i32,
}