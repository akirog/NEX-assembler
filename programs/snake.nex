// ---------- Shitty snake copy -----------
#include "programs/libraries/stdlib.nex"

#define MAX_SNAKE_LENGTH 200

char shell_name[24] = "shell";


int snake_x[MAX_SNAKE_LENGTH] = {30};
int snake_y[MAX_SNAKE_LENGTH] = {30};

int snake_len = 1;
 
// Snake dir:
// 0: right
// 1: up
// 2: left
// 3: down
int snake_dir = 0;


int main() {
    
    draw_snake();

    while (true) {
        char key = read_key();

        if (key == (char)0) {
            continue;
        } else if (key == 'd') {
            snake_dir = 0;
        } else if (key == 'w') {
            snake_dir = 1;
        } else if (key == 'a') {
            snake_dir = 2;
        } else if (key == 's') {
            snake_dir = 3;
        } else if (key == 'e') {
            grow_snake();
        } else if (key == (char)96) {
            return 0;
        }
        

        
        clear_snake();
        update_pos();
        draw_snake();
    }
}


void grow_snake() {
    snake_len += 1;

    if (snake_len >= MAX_SNAKE_LENGTH) {
        snake_len = MAX_SNAKE_LENGTH;
    }
}


void update_pos() {
    if (snake_dir > 3) {
        snake_dir = 0;
    }

    shift_snake();

    if (snake_dir == 0) {
        snake_x[0] = snake_x[0] + 1;
    } else if (snake_dir == 1) {
        snake_y[0] = snake_y[0] - 1;
    } else if (snake_dir == 2) {
        snake_x[0] = snake_x[0] - 1;
    } else {
        snake_y[0] = snake_y[0] + 1;
    }
}


void shift_snake() {
    for (int i = snake_len - 1; i > 0; i -= 1) {
        snake_x[i] = snake_x[i-1];
        snake_y[i] = snake_y[i-1];
    }
}


void draw_snake() {
    char* pos = 0x4000 + snake_x[0] + snake_y[0]*SCREEN_WIDTH;

    *pos = '#';
}

void clear_snake() {
    char* pos = 0x4000 + snake_x[snake_len-1] + snake_y[snake_len-1]*SCREEN_WIDTH;

    *pos = (char)0;
}