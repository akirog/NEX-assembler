int main() {
    asm (
        // Set screen to ascii 8
        "mov r1, 0x100"
        "mov r2, 0"
        "io zero, r1, r2, screen"
        
        // reset these?
        "mov r1, 0x102"
        "mov r2, 0xFFFFFFFF"
        "io zero, r1, r2, screen"

        "mov r1, 0x103"
        "mov r2, 0"
        "io zero, r1, r2, screen"
    );

    char mystr[] = "Hello world!";

    print(mystr);


    void (*thisprnt)(char[]);
    thisprnt = print;

    thisprnt(mystr);
    

    return 0;
}



void print(char string[]) {
    int i = 0;
    while (string[i] != (char)0) {
        *(char*)(0x81000000+i) = string[i];
        i += 1;
    }
    return;
}