#define LOCATION 1000


int main() {

    char test_string[] = "Hello";

    print_string(test_string, &main);
    
    asm (
        "io r0, r0, r0, 0 ; Halt"
    );

    return 0;
}



void print_string(char string[], char* location) {
    int idx = 0;
    while (string[idx] != 0) {
        location[idx] = string[idx];

        idx += 1;
    }

    return;
}

