section .data:
_data_base:
db 4 + _data_base
db 0
db 0
db 0
db 26
db 0
db 0
db 0
db 253
db 62
db 0
db 0
section .text:
_start:
mov bp, 0x3FFFF
mov sp, 0x3FFFF

main:   ; Function declaration
;FUNCTION INIT:
push bp
mov bp, sp
sub sp, sp, 0

;FUNCTION ARGUMENTS:

;FUNCTION BODY:
mov r6 2 ; Primary number: 2
mov lp, _data_base
add r8, lp, 0 ; Global var: num1
load r7, [r8] ; Primary Identifier: num1
mov r9 1 ; Primary number: 1
mul r9, r9, 4 ; Index offset as index * size
add r7, r7, r9 ; Address access, base_location + index offset
store [r7] r6 ; Assignment of: Index<int, Variable<Pointer<int, 2>, num1>, Value<int, 1>> = Value<int, 2>

; Return
mov sp, bp
pop bp
ret
