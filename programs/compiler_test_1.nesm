section .data:
_data_base:
db 4 + _data_base
db 89
db 111
db 117
db 32
db 112
db 114
db 101
db 115
db 115
db 101
db 100
db 32
db 115
db 111
db 109
db 101
db 116
db 104
db 105
db 110
db 103
db 33
db 0
_data_end:
section .text:
_start:
mov bp, 0x3FFFF
mov sp, 0x3FFFF

main:   ; Function declaration
;FUNCTION INIT:
push bp
mov bp, sp
sub sp, sp, 0

;FUNCTION ARGUMENTS:

;FUNCTION BODY:

; Assembly block:

mov r0, int_handler
io r0, r0, r0, 1 ; Set interrupt handler


; While loop
_loop_1_start:
mov r6 1 ; Primary number: Value<bool, 1>
cmp r6, 0
jz _loop_2_end
jmp _loop_1_start
_loop_2_end:

; Return
mov r6 0 ; Primary number: Value<int, 0>
mov ra, r6 ; Return value
mov sp, bp
pop bp
ret

; Return
mov sp, bp
pop bp
ret


int_handler:   ; Function declaration
;FUNCTION INIT:
push bp
mov bp, sp
sub sp, sp, 0

;FUNCTION ARGUMENTS:

;FUNCTION BODY:

; Assembly block:

io r1, r1, r1, 2


; Function call to print_string
mov lp, _data_base
add r7, lp, 0 ; Global var: test_string
load r6, [r7] ; Primary Identifier: test_string
mov a0, r6
mov r8 1000 ; Primary number: Value<int, 1000>
mov a1, r8
call print_string

; Assembly block:

mov r0, 0
io r0, r0, r0, 0 ; Halt


; Assembly block:

iret


; Return
mov sp, bp
pop bp
ret

; Return
mov sp, bp
pop bp
ret


print_string:   ; Function declaration
;FUNCTION INIT:
push bp
mov bp, sp
sub sp, sp, 12

;FUNCTION ARGUMENTS:
store [bp - 4], a0
store [bp - 8], a1

;FUNCTION BODY:
mov r6 0 ; Primary number: Value<int, 0>
sub r7, bp, 12 ; Local variable address: idx
store [r7] r6 ; Variable declaration with initial value: idx = Value<int, 0>

; While loop
_loop_3_start:
sub r7, bp, 4 ; Local variable address: string
load r6, [r7] ; Primary Identifier: string
sub r9, bp, 12 ; Local variable address: idx
load r8, [r9] ; Primary Identifier: idx
mul r8, r8, 1 ; Index offset as index * size
add r6, r6, r8 ; Address access, base_location + index offset
load r6, [r6]
and r6, r6, 255 ; Single byte load, and with 0xFF
mov r10 0 ; Primary number: Value<int, 0>
mov r11, 1
cmp r6, r10 ; Expression: Binary Operation(!=)<char, Index<char, Variable<Pointer<char>, string>, Variable<int, idx>>, Value<int, 0>>
jne _comparison_0
mov r11, 0
_comparison_0:
cmp r11, 0
jz _loop_4_end
sub r7, bp, 4 ; Local variable address: string
load r12, [r7] ; Primary Identifier: string
sub r8, bp, 12 ; Local variable address: idx
load r9, [r8] ; Primary Identifier: idx
mul r9, r9, 1 ; Index offset as index * size
add r12, r12, r9 ; Address access, base_location + index offset
load r12, [r12]
and r12, r12, 255 ; Single byte load, and with 0xFF
sub r10, bp, 8 ; Local variable address: location
load r6, [r10] ; Primary Identifier: location
sub r8, bp, 12 ; Local variable address: idx
load r7, [r8] ; Primary Identifier: idx
mul r7, r7, 1 ; Index offset as index * size
add r6, r6, r7 ; Address access, base_location + index offset
store byte [r6] r12 ; Assignment of: Index<char, Variable<Pointer<char>, location>, Variable<int, idx>> = Index<char, Variable<Pointer<char>, string>, Variable<int, idx>>
sub r7, bp, 12 ; Local variable address: idx
load r6, [r7] ; Primary Identifier: idx
mov r8 1 ; Primary number: Value<int, 1>
add r6, r6, r8 ; Expression: Binary Operation(+)<int, Variable<int, idx>, Value<int, 1>>
sub r9, bp, 12 ; Local variable address: idx
store [r9] r6 ; Assignment of: Variable<int, idx> = Binary Operation(+)<int, Variable<int, idx>, Value<int, 1>>
jmp _loop_3_start
_loop_4_end:

; Return
mov sp, bp
pop bp
ret

; Return
mov sp, bp
pop bp
ret
