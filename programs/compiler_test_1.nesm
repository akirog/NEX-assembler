section .data:
_data_base:
section .text:
_start:
mov bp, 0x3FFFF
mov sp, 0x3FFFF

main:   ; Function declaration
;FUNCTION INIT:
push bp
mov bp, sp
sub sp, sp, 0

;FUNCTION ARGUMENTS:

;FUNCTION BODY:

; If statement
mov r6 1 ; Primary number: 1
mov r7 1 ; Primary number: 1
mov r8, 1
cmp r6, r7 ; Expression: Binary Operation(!=)<int, Value<int, 1>, Value<int, 1>>
jne _comparison_0
mov r8, 0
_comparison_0:
mov r9 1 ; Primary number: 1
mov r10 1 ; Primary number: 1
mov r11, 1
cmp r9, r10 ; Expression: Binary Operation(==)<int, Value<int, 1>, Value<int, 1>>
je _comparison_1
mov r11, 0
_comparison_1:
and r8, r8, r11 ; Expression: Binary Operation(&&)<int, Binary Operation(!=)<int, Value<int, 1>, Value<int, 1>>, Binary Operation(==)<int, Value<int, 1>, Value<int, 1>>>
cmp r8, 0
jz _if_else_0

; Assembly block:

            mov r1, 1
            io r0, r1, r0, 0 ; Halt error code 1
        
_if_else_0:
_if_end_0:

; Assembly block:

        io r0, r0, r0, 0 ; Halt no error code
    

; Return
mov sp, bp
pop bp
ret
