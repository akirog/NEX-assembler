// =====================================================================
//  THE LEGEND OF NEX  -  a tiny Zelda-like for the NEX machine
// =====================================================================
//  Controls: W A S D = walk, J = swing sword, Q = quit
//  Touching the red Octorok costs a heart. Hit it with the sword (it dies in one hit).
//  The world is turn based: the Octorok moves every other key press.
//
//  Screen: pixel32 mode, 96x72 pixels (io screen cmd 2 with value 23 gives 4*24 x 3*24).
//  The screen is 12x9 tiles of 8x8 pixels:
//      tile row 0     = HUD (hearts)
//      tile rows 1-8  = the play-field, stored in world_map (12 x 8 tiles per room)
//  Framebuffer lives at 0x4000, one int per pixel, colour = 0x00BBGGRR.
//
//  Walk off the right edge of room 0 (or the left edge of room 1) to flip screens.
//  Every room keeps its own Octorok.
//
//  Notes about the toolchain, learned the hard way:
//   - only < > == != are used: the assembler turns >= and <= into bl/bg with swapped operands,
//     which are strict compares, so 5 >= 5 and 5 <= 5 both come out false
//   - the expression parser groups a - b + c as a - (b + c), so a minus is always the LAST operator
//   - a parenthesised right operand must end the expression, so those go in a temp variable
//   - function calls clobber t-registers, so a call never sits inside a bigger expression
//   - read_key is asm and keeps its result in v0, no scratch memory is needed
//   - the program image must stay below 0x4000 bytes or it runs into the framebuffer. Check the
//     size of legend.bin, and move FRAMEBUF (here and in main's asm block) if it ever gets close.
// =====================================================================

#define FRAMEBUF 0x4000
#define STEP 2

// ---- game state -----------------------------------------------------
int link_x = 40;        // top-left pixel of Link's 8x8 sprite
int link_y = 40;
int link_dir = 0;       // 0 = down, 1 = up, 2 = left, 3 = right
int link_anim = 0;      // flips every step, mirrors the sprite to fake a walk cycle
int cur_room = 0;
int hearts = 3;
int hurt = 0;           // > 0 while Link is invulnerable (he blinks)
int tick = 0;           // counts player actions
int seed = 17;          // tiny random number generator for the Octorok
int sword_on = 0;
int sword_x = 0;
int sword_y = 8;

// one Octorok per room
int en_x[2] = {64, 32};
int en_y[2] = {32, 24};
int en_dir[2] = {2, 0};
int en_alive[2] = {1, 1};

// everything that gets drawn on top of the tiles: 0 = Octorok, 1 = sword, 2 = Link
int e_on[3];
int e_x[3];
int e_y[3];
int e_base[3];          // offset of the sprite inside ent_gfx
int e_fx[3];            // 1 = mirror horizontally
int e_fy[3];            // 1 = mirror vertically
int tilebuf[64];        // scratch: one tile is composed here, then copied to the screen in one go

// ---- palette: index -> 0x00BBGGRR ---------------------------------------
// 0 black / transparent in sprites
int palette[17] = {
    0x000000,   // 0  black
    0x90C8E8,   // 1  ground
    0x70ACD0,   // 2  ground speck
    0x107000,   // 3  tree dark
    0x30B820,   // 4  tree light
    0x2464B4,   // 5  brown
    0x10346C,   // 6  dark brown
    0xF05828,   // 7  water
    0xFCA878,   // 8  water ripple
    0x88B8F8,   // 9  skin
    0x00A800,   // 10 tunic green
    0x0050A0,   // 11 hair
    0x2828E0,   // 12 heart red
    0xF8F8F8,   // 13 white
    0x202020,   // 14 eye
    0xA8A8A8,   // 15 grey
    0x101090    // 16 dark red
};

// ---- tile graphics: 5 tiles x 8x8, values are palette indices -----------
// tile 0 ground   1 cave   2 tree   3 rock   4 water
// 0 and 1 are walkable, everything above is solid
char tile_gfx[320] = {
