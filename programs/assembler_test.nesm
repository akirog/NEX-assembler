section .data
    _str: db "Hello world"
    _strlen: dw $ - _str

section .text

    mov r1, 1
    mov r2, 0x300
    io zero, r1, r2, screen

    mov r1, _halt
    setvec zero, r1, zero


    mov r1, _str
    mov r2, _strlen
    mov gp, __data_section

    add r1, r1, gp
    add r2, r2, gp
    
    mov r3, 0x300

    _print_loop:

    loadb r4, [r1]
    storeb [r3], r4

    addi r1, r1, 1
    addi r3, r3, 1 

    bne r1, r2, _print_loop
    
    _halt_loop:
    j _halt_loop


    _halt:
    jal _print_int
    iret zero, zero, zero


    _print_int:

    io r5, zero, zero, keyboard

    mov r6, 0x100
    and r6, r6, r5

    be r6, zero _nokey

    mov r6, 0xFF
    and r6, r5, r6
    mov r7, 0x0D ; backspace

    beq r6, r7, _backspace

    storeb [r3], r5
    addi r3, r3, 1
    j _nokey


    _backspace:
    subi r3, r3, 1
    storeb [r3], zero

    _nokey:
    jr ra