section .data
    _string: db "Hello world!"
    _strend: $ - _string

section .text
    mov r10, __data_section
    load r11, [r10 + _strend]
    store [r0 + 200], r11

    mov r1, 0x100      ; r1 = base address 0x100

    mov r2, _string
    mov r4, __data_section
    add r2, r2, r4  ; String index

    mov r3, _strend
    add r3, r3, r4  ; End address

    _print_loop:

    loadb r4, [r2]
    storeb [r1], r4

    addi r1, r1, 1
    addi r2, r2, 1

    bne r2, r3, _print_loop

    io r0, r0, r0, 0        ; halt