// ERR 72: parameters missing types
int f3(a, b) { return a; }
// ERR 73: parameter missing name
int f4(int) { return 0; }
// ERR 74: double comma in parameters
int f5(int a,, int b) { return a; }
// ERR 75: function body missing braces
int f6() return 1;
// ERR 76: function missing return type
no_ret_type(int a) { return a; }
// ERR 77: number as return type
5 f7() { }
// ERR 78: keyword as function name
