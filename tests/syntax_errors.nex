// NEX syntax error torture test
// Stages fire in this order, no matter where an error sits in the file:
//   1. preprocessor (#lines, in file order)
//   2. lexer (all of them, in file order)
//   3. parser (in file order)
// The last two errors are at the very bottom of the file on purpose.

// ---------- preprocessor ----------
// ERR 1: #include path without quotes
//#include stdlib.nex
// ERR 2: #include of a file that doesn't exist (quoted)
//#include "does_not_exist.nex"
// ERR 3: #include of a library file that doesn't exist
//#include <does_not_exist.nex>
// ERR 4: #baseaddr with a non-expression
//#baseaddr banana
// ERR 5: #baseaddr with an incomplete expression
//#baseaddr 1 +
// ERR 6: #baseaddr with no argument
//#baseaddr
// ERR 7: #define with only a name
//#define ONLY_A_NAME
// ERR 8: unknown directive
//#pragma once
// ERR 9: conditional directive (unsupported)
//#ifdef DEBUG
// ERR 10: space between # and directive name
//# define SPACED 1
// ERR 11: #define with a double space (nasty, mangles the whole file)
//#define  DOUBLE_SPACE 1

// ---------- valid declarations the snippets below rely on ----------
struct Point { int x; int y; };
Point p;
int x = 0;
int y = 0;
int arr[4] = {1, 2, 3, 4};
int add(int a, int b) { return a + b; }

// ---------- lexer ----------
// ERR 12: unterminated char literal
char lex_c1 = 'a';
// ERR 13: empty char literal
char lex_c2 = '';
// ERR 14: multi-character char literal
char lex_c3 = 'b';
// ERR 15: char literal that is only an escaped quote
char lex_c4 = '\\';
// ERR 16: unknown character @
//int lex_at = 5 @ 3;
// ERR 17: unknown character $
//int lex_dollar = $value;
// ERR 18: unknown operator ~
//int lex_tilde = ~5;
// ERR 19: ternary operator (no ? support)
//int lex_ternary = x ? 1 : 2;
// ERR 20: # in the middle of a line
//int lex_hash = 5; # not a comment
// ERR 21: smart quotes
//char* lex_smart = “smart quotes”;
// ERR 22: non-ascii identifier
//int λ = 1;
// ERR 23: backslash
//int lex_backslash = 5 \ 3;
// ERR 24: backtick
//int lex_tick = `5`;
// ERR 25: asm block that is never closed
void lex_unterminated_asm() {
    asm (
        "mov t0, 1"
        "mov t1, 2"
    );
}

// ---------- parser: top level ----------
