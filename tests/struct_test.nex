

fn main() {
    let string = "hello world! :D";

    print(&string);

    loop {}
}

struct MyStruct {
    a: char,
    b: char,
}


fn print(string: [char]) {
    let idx = 0;
    while idx < string.len {
        *((0x400 + idx) as *char)  = string[idx]; 
        idx += 1;
    };
    *((0x400 + string.len) as *char) = '0';
    return;
}