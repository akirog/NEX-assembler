

fn main() {
    let strooct: MyStruct = MyStruct {
        b: 'h',
        a: 'i',
    };

    *(0x400 as *MyStruct) = strooct;
    *(0x410 as *char) = strooct.a;

    let string = "hello world";

    let slice: [char] = &string;

    print(slice);

    loop {}
}

struct MyStruct {
    a: char,
    b: char,
}


fn print(string: [char]) {
    let idx = 0;
    while idx < string.len {
        *((0x420 + idx) as *char)  = string[idx]; 
        idx += 1;
    }
    return;
}