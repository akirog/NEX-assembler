fn main() {
    let message_string = "hello world :D";

    let message = Message {
        text: &message_string,
        data: [0, 2],
        chr: 'b'
    };

    print(message);

    *(0x400 as *char) = *(&message_string[0]);

    loop {}
}

fn print(message: Message) {
    let index: u32 = 0;

    while index < message.text.len {
        *((0x4000 + index) as *char) = message.text[index];
        index += 1;
    };

    return;
}


struct Message {
    data: [u8; 2],
    text: [char],
    chr: char,
}