fn main() {
    let string: [char; 10] = "Hello world";
    let character: char = 'a';
    let int: i32 = 20;
    let boolean: bool = true;

    int = 1 * 2 + 3;
    int = 1 + 2 * 3;
    int = 1 * (2 + 3);

    print(int as [char]);
    print(string);
}


fn print(string: [char; 10]) {
    let i: u8 = 0;
    while string[i] != '\0' {
        *(0x4000 + i) = string[i];
    }
}

type MyType = [i8; 2];


fn something() -> void {
    let var: MyType = [ 1, 2 ];
}

