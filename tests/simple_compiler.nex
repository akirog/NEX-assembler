fn main() {
    let message = "hello world";

    // Expect "hello world" at 0x4000
    print((&message) as [char]);

    // Writes at a non-zero index, which exercises the base + index path
    message[0] = 'j';
    message[10] = 'D';

    // Expect "jello worlD" at 0x4000
    print((&message) as [char]);

    let total: u8 = 1 + 2 + 3;

    loop {}
}

fn print(string: [char]) {
    let index: u32 = 0;

    while index < 11 {
        *((0x4000 + index) as *char) = string[index];
        index += 1;
    };

    return;
}