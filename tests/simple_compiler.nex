fn main() {
    let c: char;

    loop {
        c = get_char();

        if c == 0 as char {
            continue;
        };

        *(0x400 as *char) = c;
    }
}


fn get_char() -> char {
    let c: char = '\0';
    __asm (
        "addi at, zero, 1"
        "io t1, at, zero, keyboard"
        out(c, 1)
    );
    return c;
}