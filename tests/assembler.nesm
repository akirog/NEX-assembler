section .data
    _str: db "Hello world"
    _strlen: dw $ - _str
    _num: dw 0x01020304

section .text
    mov r1, _str
    mov r2, _strlen
    mov gp, __data_section

    add r1, r1, gp
    add r2, r2, gp

    mov r3, 0x00

    _print_loop:

    loadb r4, [r1]
    storeb [r3], r4

    addi r1, r1, 1
    addi r3, r3, 1 

    bne r1, r2, _print_loop

    io r0, r0, r0, halt